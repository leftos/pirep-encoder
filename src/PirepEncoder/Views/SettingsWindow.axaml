<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:PirepEncoder.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="420" d:DesignHeight="280"
        x:Class="PirepEncoder.Views.SettingsWindow"
        x:DataType="vm:SettingsViewModel"
        Title="Settings"
        Width="440" Height="300"
        WindowStartupLocation="CenterOwner"
        CanResize="False">
    <StackPanel Margin="16" Spacing="12">
        <TextBlock Text="PIREP Encoder — Settings" FontSize="16" FontWeight="SemiBold" />

        <StackPanel Spacing="4">
            <TextBlock Text="Default SA identifier" FontSize="12" Opacity="0.75" />
            <TextBox Text="{Binding DefaultSaIdentifier}" FontFamily="Consolas" MaxLength="3" PlaceholderText="e.g. BOS" />
        </StackPanel>

        <CheckBox IsChecked="{Binding PrefixWithSaIdentifier}" Content="Prefix encoded output with SA identifier" />

        <StackPanel Spacing="4">
            <TextBlock Text="Default aircraft type (optional)" FontSize="12" Opacity="0.75" />
            <TextBox Text="{Binding DefaultAircraftType}" FontFamily="Consolas" MaxLength="4" PlaceholderText="e.g. B738" />
        </StackPanel>

        <TextBlock Text="Settings persist to %APPDATA%/PirepEncoder/settings.json." FontSize="11" Opacity="0.6" TextWrapping="Wrap" />

        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Spacing="8">
            <Button Content="Close" Click="OnCloseClick" />
        </StackPanel>
    </StackPanel>
</Window>
